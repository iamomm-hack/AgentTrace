{
  "name": "agenttrace-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic AgentTrace run recording and replay backend",
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/index.ts",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  }
}
